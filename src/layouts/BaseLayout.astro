---
import { Font } from "astro:assets";
import { defaultLocale, locales, type Locale } from "@/i18n/config";
import { getCurrentLocale, getLocalizedPath } from "@/i18n/utils";
import NavigationBar from "@/components/navigationBar/navigationBar.astro";
import Footer from "@/components/footer/footer.astro";
import { THEME_STORAGE_KEY } from "@/components/themeToggle/theme";
import "@/styles/global.scss";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

// Open Graph locales are language_TERRITORY.
const ogLocales: Record<Locale, string> = { fr: "fr_FR", en: "en_US", es: "es_ES" };

const lang = getCurrentLocale(Astro.currentLocale);
const isNotFound = Astro.response.status === 404;
const isIndexable = Astro.site && !isNotFound;
const toAbsolute = (path: string): string => new URL(path, Astro.site).href;

const canonical = isIndexable ? toAbsolute(Astro.url.pathname) : undefined;
const alternates = isIndexable
  ? [
      ...locales.map((locale) => ({
        hreflang: locale,
        href: toAbsolute(getLocalizedPath(Astro.url.pathname, locale)),
      })),
      { hreflang: "x-default", href: toAbsolute(getLocalizedPath(Astro.url.pathname, defaultLocale)) },
    ]
  : [];
const ogImage = toAbsolute(`/og/og-${lang}.png`);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {isNotFound && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    <!-- Link previews (LinkedIn, Slack, X…) -->
    {
      canonical && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="Victor Deleau" />
          <meta property="og:url" content={canonical} />
          <meta property="og:title" content={title} />
          {description && <meta property="og:description" content={description} />}
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={title} />
          <meta property="og:locale" content={ogLocales[lang]} />
          {locales
            .filter((locale) => locale !== lang)
            .map((locale) => (
              <meta property="og:locale:alternate" content={ogLocales[locale]} />
            ))}
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <Font cssVariable="--font-albert-sans" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-dm-mono" />
    <meta name="generator" content={Astro.generator} />
    <!-- Inline and blocking on purpose: sets the theme before the first paint, so it never flashes. -->
    <script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY }}>
      let theme = null;
      try {
        theme = localStorage.getItem(storageKey);
      } catch {}
      if (theme !== "light" && theme !== "dark") {
        theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      document.documentElement.dataset.theme = theme;
    </script>
    <!-- Page-specific head content (e.g. the root 404 redirect) -->
    <slot name="head" />
  </head>
  <body>
    <NavigationBar />
    <slot />
    <Footer />
  </body>
</html>
