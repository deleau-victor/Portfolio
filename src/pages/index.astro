---
import { defaultLocale } from "@/i18n/config";

// Statically built page: the visitor's language can only be known in the browser.
const fallbackUrl = `/${defaultLocale}/`;
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Portfolio</title>
    <noscript><meta http-equiv="refresh" content={`0;url=${fallbackUrl}`} /></noscript>
    <script>
      import { getPreferredLocale } from "@/i18n/preferredLocale";

      location.replace(`/${getPreferredLocale()}/`);
    </script>
  </head>
  <body>
    <a href={fallbackUrl}>Continue</a>
  </body>
</html>
