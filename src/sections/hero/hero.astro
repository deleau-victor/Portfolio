---
import { localeNames } from "@/i18n/config";
import { getCurrentLocale, useTranslations } from "@/i18n/utils";
import { cvs, getMainCv } from "./cv";
import Download from "@/components/icons/download.svg";
import ChevronDown from "@/components/icons/chevronDown.svg";
import Orbs from "@/components/orbs/orbs.astro";

const lang = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(lang);
const mainCv = getMainCv(lang);
---

<section class="hero" aria-labelledby="hero-name" id="top">
  <div class="hero__container">
    <!-- Canvas -->
    <Orbs />
    <!-- Identity -->
    <div class="hero__identity">
      <p class="hero__identity__role" data-i18n="hero.role">{t("hero.identity.role")}</p>
      <h1 class="hero__identity__name" id="hero-name">Victor Deleau</h1>
      <p class="hero__identity__line" data-i18n="hero.line">
        {t("hero.identity.line")}
      </p>
      <p class="hero__identity__proof" data-i18n="hero.proof">
        {t("hero.identity.proof")}
      </p>
      <p class="hero__identity__availability">
        <span aria-hidden="true"></span><span data-i18n="avail">{t("hero.identity.availability")}</span>
      </p>
    </div>
    <!-- ACTIONS  -->
    <div class="hero__actions">
      <!-- contact -->
      <a class="hero__actions__contact" href="#contact">{t("hero.contact")}</a>
      <!-- cv -->
      {
        mainCv && (
          <div class="hero__actions__cv" data-cv>
            <a
              class="hero__actions__cv__download"
              href={mainCv.href}
              hreflang={mainCv.locale}
              download={mainCv.filename}
              aria-disabled={mainCv.href ? undefined : "true"}
            >
              <Download aria-hidden="true" />
              <span>{t("hero.cv")}</span>
              <span class="code">{mainCv.locale.toUpperCase()}</span>
            </a>
            {cvs.length > 1 && (
              <button
                type="button"
                class="hero__actions__cv__toggle"
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="cv-menu"
                aria-label={t("hero.cvLang")}
                data-cv-toggle
              >
                <ChevronDown aria-hidden="true" />
              </button>
              <ul class="hero__actions__cv__menu" id="cv-menu" hidden data-cv-menu>
                {cvs.map((cv) => (
                  <li>
                    <a
                      href={cv.href}
                      hreflang={cv.locale}
                      lang={cv.locale}
                      download={cv.filename}
                      aria-current={cv.locale === mainCv.locale ? "true" : undefined}
                    >
                      <span>{localeNames[cv.locale]}</span>
                      <span class="code">{cv.locale.toUpperCase()}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  import { setupDropdownMenu } from "@/scripts/dropdownMenu";

  // CV DROPDOWN //
  document.querySelectorAll<HTMLElement>("[data-cv]").forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>("[data-cv-toggle]");
    const menu = root.querySelector<HTMLUListElement>("[data-cv-menu]");
    if (trigger && menu) {
      setupDropdownMenu(root, trigger, menu);
    }
  });
</script>

<style lang="scss">
  @use "./hero.scss";
</style>
